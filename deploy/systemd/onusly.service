[Unit]
Description=ONUSLY Go API Backend Service
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/onusly
EnvironmentFile=/etc/onusly/onusly.env
ExecStart=/opt/onusly/server
Restart=always
RestartSec=5
LimitNOFILE=65536

# Standard security sandbox options for systemd
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
