{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "package:ext": "node -e \"const cp=require('child_process');try{cp.execSync('python3 ../scripts/package-extension.py',{stdio:'inherit'})}catch(e){cp.execSync('python ../scripts/package-extension.py',{stdio:'inherit'})}\"",
    "build": "node -e \"const cp=require('child_process');try{cp.execSync('python3 ../scripts/package-extension.py',{stdio:'inherit'})}catch(e){cp.execSync('python ../scripts/package-extension.py',{stdio:'inherit'})}\" && vite build",
    "lint": "eslint .",
    "test": "node --test tests/**/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
