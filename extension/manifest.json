{
  "manifest_version": 3,
  "name": "ONUSLY — Accountability Website Blocker",
  "version": "1.0.0",
  "description": "Blocks distracting websites during active ONUSLY accountability goals.",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "ONUSLY"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@onusly.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "webNavigation",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.onusly.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "http://localhost:5173/*",
      "http://localhost:5174/*",
      "http://localhost:5175/*",
      "http://localhost:4173/*",
      "http://localhost:8080/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:5173/*",
      "http://127.0.0.1:5174/*",
      "http://127.0.0.1:5175/*",
      "http://127.0.0.1:4173/*",
      "http://127.0.0.1:8080/*",
      "http://127.0.0.1:3000/*",
      "https://*.onusly.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.instagram.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.netflix.com/*",
        "*://*.discord.com/*",
        "*://*.twitch.tv/*"
      ],
      "js": ["src/pageBlocker.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": ["src/youtubeShortsLoader.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.onusly.com/*"
      ],
      "js": ["src/dashboardBridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/youtubeShortsContent.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
