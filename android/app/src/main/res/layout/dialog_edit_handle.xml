<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvEditHandleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Customize @Handle"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEditHandleSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:text="Choose your unique handle. Partners can find you by @handle to assign you as their accountability approver." />

    <!-- Error Banner -->
    <TextView
        android:id="@+id/tvEditHandleError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:background="@color/warning_bg"
        android:textColor="@color/error"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Handle Field -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="NEW @HANDLE *"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etEditHandleInput"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@color/surface_card"
        android:paddingHorizontal="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        android:maxLength="30"
        android:singleLine="true"
        android:hint="@alex_run" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/pbSavingHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEditHandle"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            app:strokeColor="@color/surface_card"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEditHandle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Save Handle"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/primary"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
