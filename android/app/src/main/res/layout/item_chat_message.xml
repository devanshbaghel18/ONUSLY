<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMessageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/tvChatSender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:textColor="#888888"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMessageBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Verification Card Header if isProof -->
            <LinearLayout
                android:id="@+id/layoutVerificationHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvVerificationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ GOAL VERIFICATION"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvChatGoalTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 Goal Title"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvChatMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <!-- Decision Action Buttons for Approver -->
            <LinearLayout
                android:id="@+id/layoutVerificationActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChatApprove"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Approve"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#000000"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChatReject"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Reject"
                    android:textSize="11sp"
                    android:textColor="#FF6B6B"
                    app:strokeColor="#FF6B6B"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <!-- Approved State Banner -->
            <TextView
                android:id="@+id/tvChatApprovedStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ Verified &amp; Unlocked"
                android:textColor="#4EBA6F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvChatMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:textColor="#777777"
                android:textSize="9sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
